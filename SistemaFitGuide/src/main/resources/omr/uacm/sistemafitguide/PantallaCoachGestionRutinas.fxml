<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #E4F2E7, #93BFB7);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="omr.uacm.sistemafitguide.PantallaCoachGestionRutinasController">
   <children>
      <VBox maxHeight="560.0" maxWidth="860.0" prefHeight="560.0" prefWidth="860.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 12, 0, 0, 6); -fx-padding: 20;">
         <children>
            <!-- Barra Superior -->
            <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="820.0" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#RegresarMenu" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 6 14;" text="← Volver al Menú">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Gestión de Rutinas y Progresión de Usuarios" textFill="#1b3a2d">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label text="Selecciona un usuario para ver sus rutinas y adaptar su carga progresiva" textFill="#757575">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Button fx:id="btnEditarProgresion" mnemonicParsing="false" onAction="#EditarRutinaProgresion" style="-fx-background-color: #00695C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 18;" text="⚙️ Editar Rutina (Progresión)">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>

            <!-- Contenido Principal: Split horizontal -->
            <SplitPane dividerPositions="0.38" prefHeight="460.0" prefWidth="820.0" VBox.vgrow="ALWAYS">
               <items>
                  <!-- Panel Izquierdo: Lista de Usuarios -->
                  <VBox spacing="8.0" style="-fx-padding: 10;">
                     <children>
                        <Label text="👥 Usuarios Registrados" textFill="#1b3a2d">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TableView VBox.vgrow="ALWAYS" fx:id="tablaUsuarios" prefHeight="220.0" prefWidth="500.0">
                           <columns>
                              <TableColumn fx:id="colUsuarioId" prefWidth="40.0" text="ID" />
                              <TableColumn fx:id="colUsuarioNombre" prefWidth="120.0" text="Nombre" />
                              <TableColumn fx:id="colUsuarioPeso" prefWidth="55.0" text="Peso" />
                              <TableColumn fx:id="colUsuarioAltura" prefWidth="55.0" text="Alt" />
                              <TableColumn fx:id="colUsuarioGenero" prefWidth="60.0" text="Gen" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- Panel Derecho: Rutinas del Usuario + Detalle de Ejercicios -->
                  <VBox spacing="10.0" style="-fx-padding: 10;">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="lblUsuarioSeleccionado" text="Selecciona un usuario de la lista" textFill="#2e7d32">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>

                        <TableView VBox.vgrow="ALWAYS" fx:id="tablaRutinas" prefHeight="400.0" prefWidth="280.0">
                           <columns>
                              <TableColumn fx:id="colRutinaGrupo" prefWidth="90.0" text="Grupo" />
                              <TableColumn fx:id="colRutinaNivel" prefWidth="90.0" text="Nivel" />
                              <TableColumn fx:id="colRutinaTipo" prefWidth="100.0" text="Tipo Peso" />
                              <TableColumn fx:id="colRutinaSeries" prefWidth="60.0" text="Series" />
                              <TableColumn fx:id="colRutinaDescanso" prefWidth="80.0" text="Desc (s)" />
                              <TableColumn fx:id="colRutinaPeso" prefWidth="80.0" text="Extra (kg)" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>

                        <!-- Detalle de la rutina seleccionada -->
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="lblRutinaSeleccionada" text="Detalle de Repeticiones por Ejercicio" textFill="#1b3a2d">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>

                        <TableView fx:id="tablaDetalle" prefHeight="150.0" prefWidth="500.0">
                           <columns>
                              <TableColumn fx:id="colDetalleNombre" prefWidth="350.0" text="Ejercicio" />
                              <TableColumn fx:id="colDetalleReps" prefWidth="120.0" text="Repeticiones Objetivo" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </items>
            </SplitPane>
         </children>
      </VBox>
   </children>
</StackPane>
