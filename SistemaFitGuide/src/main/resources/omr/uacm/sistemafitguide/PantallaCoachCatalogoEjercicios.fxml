<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #E4F2E7, #93BFB7);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="omr.uacm.sistemafitguide.PantallaCoachCatalogoEjerciciosController">
   <children>
      <VBox maxHeight="560.0" maxWidth="860.0" prefHeight="560.0" prefWidth="860.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 12, 0, 0, 6); -fx-padding: 20;">
         <children>
            <!-- Barra Superior -->
            <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="820.0" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#RegresarMenu" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 6 14;" text="← Volver al Menú">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Catálogo General de Ejercicios" textFill="#1b3a2d">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label text="Gestión de ejercicios de la base de datos (CRUD)" textFill="#757575">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#AgregarEjercicio" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16;" text="+ Agregar Ejercicio">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#EditarEjercicio" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16;" text="✏️ Editar">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#EliminarEjercicio" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16;" text="🗑️ Eliminar">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>

            <!-- Barra de Filtros y Búsqueda -->
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="820.0" spacing="10.0" style="-fx-background-color: #F5F7F6; -fx-background-radius: 10; -fx-padding: 6 12;">
               <children>
                  <Label text="Buscar:" textFill="#424242">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtBusqueda" prefWidth="180.0" promptText="Nombre de ejercicio..." style="-fx-background-radius: 8;" />
                  
                  <Label text="Zona:" textFill="#424242">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="cmbFiltroZona" prefWidth="110.0" style="-fx-background-radius: 8;" />

                  <Label text="Nivel:" textFill="#424242">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cmbFiltroNivel" prefWidth="110.0" style="-fx-background-radius: 8;" />

                  <Label text="Tipo:" textFill="#424242">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cmbFiltroTipoPeso" prefWidth="110.0" style="-fx-background-radius: 8;" />

                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblTotalRegistros" text="Total: 0 ejercicios" textFill="#2e7d32">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Tabla de Ejercicios -->
            <TableView VBox.vgrow="ALWAYS" fx:id="tablaEjercicios" prefHeight="400.0" prefWidth="820.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                  <TableColumn fx:id="colZona" prefWidth="90.0" text="Zona" />
                  <TableColumn fx:id="colNivel" prefWidth="95.0" text="Nivel" />
                  <TableColumn fx:id="colTipoPeso" prefWidth="100.0" text="Tipo Peso" />
                  <TableColumn fx:id="colRepeticiones" prefWidth="55.0" text="Reps" />
                  <TableColumn fx:id="colSeries" prefWidth="55.0" text="Series" />
                  <TableColumn fx:id="colDescanso" prefWidth="65.0" text="Desc (s)" />
                  <TableColumn fx:id="colDuracion" prefWidth="65.0" text="Dur (s)" />
                  <TableColumn fx:id="colDescripcion" prefWidth="170.0" text="Descripción" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</StackPane>
