<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #E4F2E7, #93BFB7);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="omr.uacm.sistemafitguide.PantallaCoachFormularioEjercicioController">
   <children>
      <VBox maxHeight="560.0" maxWidth="860.0" prefHeight="560.0" prefWidth="860.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 12, 0, 0, 6); -fx-padding: 25;">
         <children>
            <!-- Encabezado con Botón de Regreso -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#Cancelar" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 6 14;" text="← Cancelar y Volver">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblTituloPantalla" text="Formulario de Ejercicio" textFill="#1b3a2d">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblSubtituloPantalla" text="Completa los atributos para gestionar el ejercicio en el catálogo" textFill="#757575">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Contenedor con Scroll para el Formulario -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane hgap="20.0" vgap="14.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="70.0" prefHeight="80.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <!-- Fila 0 -->
                        <Label text="Nombre del Ejercicio: *" textFill="#2e3a2f" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtNombre" promptText="ej. Flexiones Diamante" style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Zona Corporal: *" textFill="#2e3a2f" GridPane.columnIndex="2" GridPane.rowIndex="0">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbZonaCorporal" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <!-- Fila 1 -->
                        <Label text="Nivel de Dificultad: *" textFill="#2e3a2f" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbNivel" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Tipo de Peso: *" textFill="#2e3a2f" GridPane.columnIndex="2" GridPane.rowIndex="1">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbTipoPeso" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <!-- Fila 2 -->
                        <Label text="Repeticiones Sugeridas:" textFill="#2e3a2f" GridPane.columnIndex="0" GridPane.rowIndex="2">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtRepeticiones" promptText="ej. 12" style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Series Sugeridas:" textFill="#2e3a2f" GridPane.columnIndex="2" GridPane.rowIndex="2">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtSeries" promptText="ej. 3" style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <!-- Fila 3 -->
                        <Label text="Descanso (segundos):" textFill="#2e3a2f" GridPane.columnIndex="0" GridPane.rowIndex="3">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtDescanso" promptText="ej. 30" style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Duración (segundos):" textFill="#2e3a2f" GridPane.columnIndex="2" GridPane.rowIndex="3">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtDuracion" promptText="ej. 0 si es por reps" style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                        <!-- Fila 4 -->
                        <Label text="Ruta de Imagen Previa:" textFill="#2e3a2f" GridPane.columnIndex="0" GridPane.rowIndex="4">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtUrlImagen" promptText="ej. /omr/uacm/sistemafitguide/preview/..." style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Ruta de Video / GIF:" textFill="#2e3a2f" GridPane.columnIndex="2" GridPane.rowIndex="4">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtUrlVideo" promptText="ej. /omr/uacm/sistemafitguide/videos/..." style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                        <!-- Fila 5: Descripción -->
                        <Label text="Descripción e Instrucciones:" textFill="#2e3a2f" GridPane.columnIndex="0" GridPane.rowIndex="5">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextArea fx:id="txtDescripcion" promptText="Instrucciones detalladas de ejecución técnica..." wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                     </padding>
                  </GridPane>
               </content>
            </ScrollPane>

            <!-- Botones de Acción Inferiores -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#Cancelar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: #ECEFF1; -fx-text-fill: #37474F; -fx-font-weight: bold; -fx-background-radius: 12;" text="Cancelar">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#GuardarEjercicio" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 12;" text="💾 Guardar Ejercicio">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
