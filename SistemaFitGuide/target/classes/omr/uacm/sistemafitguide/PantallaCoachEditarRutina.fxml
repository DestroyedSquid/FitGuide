<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #E4F2E7, #93BFB7);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="omr.uacm.sistemafitguide.PantallaCoachEditarRutinaController">
   <children>
      <VBox maxHeight="560.0" maxWidth="860.0" prefHeight="560.0" prefWidth="860.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 12, 0, 0, 6); -fx-padding: 25;">
         <children>
            <!-- Encabezado -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#Cancelar" style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 6 14;" text="← Volver a Rutinas">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblTituloPantalla" text="Ajuste de Entrenamiento Progresivo" textFill="#1b3a2d">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblInfoUsuario" text="Atleta: Usuario" textFill="#00695c">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblInfoRutina" text="Rutina: Grupo · Nivel · Tipo" textFill="#757575">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Contenido Principal: Dos Columnas -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Columna Izquierda: Parámetros Globales de Sobrecarga Progresiva -->
                  <VBox maxWidth="340.0" prefWidth="340.0" spacing="14.0" style="-fx-background-color: #F8FBF9; -fx-border-color: #B2DFDB; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 18;">
                     <children>
                        <Label text="⚡ Variables de Sobrecarga" textFill="#004d40">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label text="Ajusta el volumen y la intensidad para provocar adaptación neuromuscular en el atleta:" textFill="#616161" wrapText="true">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Series (Vueltas al Circuito):" textFill="#2e3a2f">
                                 <font><Font name="System Bold" size="12.0" /></font>
                              </Label>
                              <Spinner fx:id="spSeries" editable="true" maxWidth="1.7976931348623157E308" prefHeight="35.0" style="-fx-background-radius: 8;" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Descanso entre Ejercicios (segundos):" textFill="#2e3a2f">
                                 <font><Font name="System Bold" size="12.0" /></font>
                              </Label>
                              <Spinner fx:id="spDescanso" editable="true" maxWidth="1.7976931348623157E308" prefHeight="35.0" style="-fx-background-radius: 8;" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Peso Extra a Cargar (kg):" textFill="#2e3a2f">
                                 <font><Font name="System Bold" size="12.0" /></font>
                              </Label>
                              <TextField fx:id="txtPesoExtra" prefHeight="35.0" promptText="ej. 5.0" style="-fx-background-radius: 8;" />
                           </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />
                        <Label style="-fx-background-color: #E8F5E9; -fx-background-radius: 8; -fx-padding: 8; -fx-text-fill: #2E7D32;" text="💡 Tip del Coach: Un incremento del 5-10% en repeticiones o peso cada 2 semanas favorece la progresión sostenida sin riesgo de sobreentrenamiento." wrapText="true">
                           <font>
                              <Font size="10.5" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <!-- Columna Derecha: Tabla de Repeticiones Específicas por Ejercicio -->
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="🎯 Repeticiones Objetivo por Ejercicio" textFill="#1b3a2d">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Region HBox.hgrow="ALWAYS" />
                              <Label text="(Haz doble clic en reps para editar)" textFill="#757575">
                                 <font>
                                    <Font name="System Italic" size="11.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>

                        <TableView fx:id="tablaEjerciciosReps" prefHeight="260.0" prefWidth="450.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colNombreEjercicio" editable="false" prefWidth="280.0" text="Nombre del Ejercicio" />
                              <TableColumn fx:id="colRepsObjetivo" prefWidth="140.0" style="-fx-alignment: CENTER;" text="Reps Objetivo (Doble Clic)" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Botones Inferiores -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#Cancelar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: #ECEFF1; -fx-text-fill: #37474F; -fx-font-weight: bold; -fx-background-radius: 12;" text="Cancelar">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="btnGuardarProgresion" mnemonicParsing="false" onAction="#GuardarProgresion" prefHeight="40.0" prefWidth="240.0" style="-fx-background-color: #00695C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 12;" text="💾 Guardar Progresión">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
